{
  "name": "threejs-sandbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run build:sandbox && bun run build:editor-data && bun --bun vite --config vite.public.config.ts --host 0.0.0.0",
    "build:editor-data": "bun scripts/build-editor-data.ts",
    "build:sandbox": "bun build src/sandbox/runtime.ts --target browser --format iife --minify --outfile public/sandbox-runtime.js",
    "typecheck": "vue-tsc --noEmit",
    "check:features": "bun scripts/check-features.ts",
    "check:rooms": "bun scripts/check-rooms.ts",
    "build:public": "bun run build:sandbox && bun run build:editor-data && bun run typecheck && bun --bun vite build --config vite.public.config.ts && bun scripts/check-public.ts",
    "preview:public": "bun --bun vite preview --config vite.public.config.ts --host 0.0.0.0",
    "build": "bun run build:public",
    "preview": "bun run preview:public"
  },
  "dependencies": {
    "three": "0.182.0",
    "vue": "3.5.44",
    "vue-router": "4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.182.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@volar/monaco": "2.4.28",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/language-core": "3.3.13",
    "@vue/language-service": "3.3.13",
    "monaco-editor": "0.52.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "volar-service-typescript": "0.0.71",
    "vscode-uri": "3.1.0",
    "vue-tsc": "3.3.13"
  },
  "patchedDependencies": {
    "monaco-editor@0.52.2": "patches/monaco-editor@0.52.2.patch",
    "@volar/monaco@2.4.28": "patches/@volar%2Fmonaco@2.4.28.patch"
  }
}
